;;
; Rename this file to .env and add the correct values for the credentials.
; SECURITY: Never commit the .env file with real values to version control!
; See ../SECURITY.md for detailed security guidelines.
;;

; ==============================================================================
; PayPal Configuration
; ==============================================================================
; Get your Client ID and Client Secret from the PayPal Developer Dashboard:
; https://developer.paypal.com/dashboard/
; 
; SECURITY: 
; - Use sandbox credentials for development/testing
; - Use production credentials only in production environments
; - Rotate credentials regularly
; - Never commit actual credentials to version control

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

; The PayPal environment to use. Accepted values: 'Sandbox' or 'Production'
PAYPAL_ENVIRONMENT=Sandbox

; Enable detailed logging (use only in development)
; WARNING: This may log sensitive request/response data - be careful in production
PAYPAL_LOG_REQUESTS=true
PAYPAL_LOG_RESPONSES=true

