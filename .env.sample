;;
; Rename this file to .env and add the correct values for the credentials.
; IMPORTANT: Never commit the .env file with real values to version control!
; See SECURITY.md for detailed security guidelines.
;;

; ==============================================================================
; LLM Configuration
; ==============================================================================
; The configurations required for the LLM. Please refer your LLM model instructions
; The examples use the OpenAI Azure LLM internal to PayPal.

OPENAI_API_BASE=
AZURE_OAUTH_URL=
AZURE_CLIENT_ID=
AZURE_SECRET=
AZURE_OAUTH_SCOPES=

; ==============================================================================
; PayPal Configuration
; ==============================================================================
; Get your Client ID and Client Secret from the PayPal Developer Dashboard:
; https://developer.paypal.com/dashboard/
; 
; SECURITY: 
; - Use sandbox credentials for development/testing
; - Use production credentials only in production environments
; - Rotate credentials regularly
; - Never commit actual credentials to version control

PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

; The PayPal environment to use. Accepted values: 'Sandbox' or 'Production'
PAYPAL_ENVIRONMENT=Sandbox

; Enable detailed logging (use only in development)
; WARNING: This may log sensitive request/response data - be careful in production
PAYPAL_LOG_REQUESTS=true
PAYPAL_LOG_RESPONSES=true

; ==============================================================================
; Twilio Configuration (if using SMS features)
; ==============================================================================
; Get your Twilio credentials from https://www.twilio.com/console

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_TO_NUMBER=

; ==============================================================================
; AWS Configuration (if using AWS Bedrock or other AWS services)
; ==============================================================================
; AWS credentials should be managed through IAM roles when possible
; See: https://docs.aws.amazon.com/general/latest/gr/aws-security-credentials.html

AWS_ACCESS_KEY_ID=
AWS_SECRET_KEY=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_SENDER_EMAIL=
AWS_RECIVER_EMAIL=
AWS_BEDROCK_MODEL_ARN=

; ==============================================================================
; Node.js/Development Configuration
; ==============================================================================
; Set to 0 to ignore certificate issues (development only)
NODE_TLS_REJECT_UNAUTHORIZED=

; ==============================================================================
; External API Keys (if integrating with other services)
; ==============================================================================
; Example: Etherscan, Blockchain, or other third-party APIs
; Always use environment variables, never hardcode keys in URLs
; Example: API_KEY= (NOT api.etherscan.io/v2/api?apikey=VALUE)

EXTERNAL_API_KEY=
BLOCKCHAIN_API_KEY=
