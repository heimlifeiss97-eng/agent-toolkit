# OpenAI Configuration
# Get your OpenAI credentials from https://platform.openai.com/account/api-keys
OPENAI_API_KEY=<api_key>
OPENAI_API_VERSION=<api_version>

# PayPal Configuration
# Get your Client ID and Client Secret from https://developer.paypal.com/dashboard/
PAYPAL_CLIENT_ID=<APP_CLIENT_ID>
PAYPAL_CLIENT_SECRET=<APP_CLIENT_SECRET>

# SECURITY: See ../../SECURITY.md for detailed security guidelines
# Never commit this file with actual values to version control!
